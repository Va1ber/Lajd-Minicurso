config_version=5

[application]

config/name="XEF-Lajd-Intensivao"
config/description="Você controla um robô “defeituoso”, cujo o nome é “XEF”, que precisa superar obstáculos, pular entre plataformas e superar hordas de inimigos para poder encontrar com o seu criador. O jogo será um plataforma com forte estilo beat ’em up, com diferentes combos de ataques e mecânicas."
config/version="0.0.1"
run/main_scene="uid://bpynwi74p76sk"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://imagens/icon.svg"
config/tags=PackedStringArray("estudo")

